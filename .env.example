# Gemini Live (audio nativo, streaming vía proxy WebSocket /ws/live).
# Developer API: solo necesita GEMINI_API_KEY (sin project id ni ADC).
# La key se obtiene en https://aistudio.google.com/api-keys y vive SOLO en el
# backend (nunca llega a la app).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Charon
# Idioma por defecto si la app no lo envía (es, en, fr, pt, it).
GEMINI_LIVE_LANGUAGE=es
# Duración máxima de la sesión en segundos (0 = sin límite propio). Para probar
# el cierre 4001 en el teléfono, usar un valor corto como 60.
GEMINI_LIVE_MAX_SESSION_S=0
# false = Lazarus en pausa: el proxy rechaza las sesiones sin abrir Gemini (no gasta saldo).
LIVE_ENABLED=true

# Control de acceso y panel del piloto (/admin). DATABASE_URL de Neon en
# producción ("postgresql://…"); en local, SQLite.
DATABASE_URL=sqlite:///./lazarus.db
# true = solo teléfonos aprobados en el panel abren sesión.
DEVICE_AUTH_REQUIRED=false
# Primer administrador del panel (se crea al arrancar si no hay ninguno).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Firma de las sesiones del panel: al menos 32 caracteres aleatorios.
ADMIN_JWT_SECRET=
# Días que se guardan los logs subidos por los teléfonos.
LOG_RETENTION_DAYS=30

# Métricas de capacidad (CPU, RAM, sesiones y tráfico del proceso) para el panel.
# PLATFORM etiqueta las muestras: "render", "aws" o "local". 0 en el intervalo = apagado.
PLATFORM=local
METRICS_INTERVAL_S=30
METRICS_RETENTION_DAYS=14

# App
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS: URLs del frontend permitidas.
CORS_ORIGINS=["http://localhost:5173"]
