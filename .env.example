# Gemini Live (audio nativo, streaming vía proxy WebSocket /ws/live).
# Developer API: solo necesita GEMINI_API_KEY (sin project id ni ADC).
# La key se obtiene en https://aistudio.google.com/api-keys y vive SOLO en el
# backend (nunca llega a la app).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Charon

# App
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS: URLs del frontend permitidas.
CORS_ORIGINS=["http://localhost:5173"]
